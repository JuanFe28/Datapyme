  "subtitles": [
    {
      "chapter": 1,
      "start": 8.3,
      "end": 14.007,
      "text": "Inventario, ventas e indicadores conectados para revisar el comercio.",
      "cps": 12.09
    },
    {
      "chapter": 1,
      "start": 14.007,
      "end": 19.3,
      "text": "Pantallas de la aplicación con datos sintéticos de demostración.",
      "cps": 12.09
    },
    {
      "chapter": 2,
      "start": 20.3,
      "end": 29.675,
      "text": "Organice el catálogo y revise cantidades, precios e IVA antes de confirmar.",
      "cps": 8.0
    },
    {
      "chapter": 2,
      "start": 29.675,
      "end": 37.3,
      "text": "Consulte el comprobante y compruebe el cambio de existencias.",
      "cps": 8.0
    },
    {
      "chapter": 3,
      "start": 38.3,
      "end": 44.38,
      "text": "Consulte ingresos sin IVA, utilidad bruta e inventario al costo.",
      "cps": 10.53
    },
    {
      "chapter": 3,
      "start": 44.38,
      "end": 50.175,
      "text": "La utilidad bruta no equivale a la ganancia neta del negocio.",
      "cps": 10.53
    },
    {
      "chapter": 3,
      "start": 50.175,
      "end": 57.3,
      "text": "Una proyección necesita historial suficiente y no garantiza ventas futuras.",
      "cps": 10.53
    },
    {
      "chapter": 4,
      "start": 58.3,
      "end": 64.882,
      "text": "Active su cuenta y recorra las funciones con datos de práctica.",
      "cps": 9.57
    },
    {
      "chapter": 4,
      "start": 64.882,
      "end": 72.3,
      "text": "Revise el archivo importado y contraste los resultados antes de operar.",
      "cps": 9.57
    },
    {
      "chapter": 5,
      "start": 73.3,
      "end": 82.3,
      "text": "Evaluemos claridad, utilidad y flujo de trabajo antes de incorporar datos de empresas.",
      "cps": 9.56
    }
