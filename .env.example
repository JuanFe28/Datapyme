# Desarrollo: valores locales persistentes, sin contraseña predeterminada.
APP_ENV=local
DATABASE_URL=sqlite:///./datapyme_local.db
# Genera una cadena aleatoria de al menos 32 caracteres. No subas .env.
SESSION_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1
# Crear cuentas mediante: python manage.py create-user --username admin --role admin
# Para primer arranque remoto, usar ADMIN_PASSWORD temporal en el proveedor.
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# Producción: APP_ENV=production, PostgreSQL y dominio exacto permitido.
# DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/postgres?sslmode=require
# ALLOWED_HOSTS=tu-servicio.onrender.com
